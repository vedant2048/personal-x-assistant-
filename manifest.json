{
  "manifest_version": 3,
  "name": "Personal X AI Assistant",
  "version": "1.0.0",
  "description": "Creates OpenRouter-powered reply drafts for visible X posts.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["*://x.com/*", "*://*.x.com/*", "*://twitter.com/*", "*://*.twitter.com/*", "http://localhost:8787/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "Personal X AI Assistant", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["*://x.com/*", "*://*.x.com/*", "*://twitter.com/*", "*://*.twitter.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
